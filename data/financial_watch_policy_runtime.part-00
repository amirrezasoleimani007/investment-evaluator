and":"good","y_band":"weak","x_band_fa":"مطلوب","y_band_fa":"ضعیف","title":"سود باکیفیت اما جریان نقد آزاد ضعیف","status_sentence":"سود شرکت از کیفیت مناسبی برخوردار است، اما سرمایه در گردش یا مخارج سرمایه‌ای بخش زیادی از نقد تولیدشده را جذب می‌کنند.","micro_policy_title":"آزادسازی جریان نقد آزاد","micro_policy":"کیفیت سود حفظ شود و تمرکز اصلی بر آزادسازی نقد از سرمایه در گردش و افزایش بهره‌وری مخارج سرمایه‌ای باشد.","priority_actions":["بهبود سرمایه در گردش و چرخه نقد","کنترل مخارج سرمایه‌ای و اولویت‌بندی پروژه‌ها","حفظ کیفیت سود همزمان با افزایش جریان نقد آزاد"],"avoid_or_guardrail":"ضعف جریان نقد آزاد صرفاً با افزایش بدهی جبران نشود.","severity":3,"domain":"نقدسازی و سرمایه در گردش","source_codes":["R1","R7","R8","R10"]},{"code":"M4-WM","matrix":4,"x_band":"weak","y_band":"medium","x_band_fa":"ضعیف","y_band_fa":"متوسط","title":"نقدسازی متوسط با کیفیت سود ضعیف","status_sentence":"شرکت تا حدی جریان نقد آزاد تولید می‌کند، اما شاخص‌های کیفیت سود نشان می‌دهند پایداری سود گزارش‌شده نیازمند بررسی و اعتبارسنجی است.","micro_policy_title":"اعتبارسنجی و بهبود کیفیت سود","micro_policy":"اقلام تعهدی، درآمدها و هزینه‌های غیرتکرارشونده و تفاوت سود با جریان نقد عملیاتی بررسی شوند تا کیفیت سود قابل اتکاتر شود.","priority_actions":["تحلیل نسبت جریان نقد عملیاتی به سود خالص (CFO/NI)","بررسی نسبت تعهدی (Accruals Ratio) و اقلام غیرتکرارشونده","نرمال‌سازی سود برای تصمیم‌های سرمایه‌گذاری و توزیع نقد"],"avoid_or_guardrail":"تصمیم توسعه یا توزیع نقد صرفاً بر مبنای سود گزارش‌شده انجام نشود.","severity":4,"domain":"کیفیت سود","source_codes":["R1","R7","R10"]},{"code":"M4-MM","matrix":4,"x_band":"medium","y_band":"medium","x_band_fa":"متوسط","y_band_fa":"متوسط","title":"کیفیت سود و نقدسازی در سطح میانه","status_sentence":"کیفیت سود و تولید جریان نقد آزاد هر دو قابل‌قبول اما فاقد مزیت برجسته‌اند و ظرفیت بهبود در تبدیل سود به نقد وجود دارد.","micro_policy_title":"بهبود تبدیل سود به نقد","micro_policy":"همزمان با حفظ سودآوری، کیفیت سود، سرمایه در گردش و بهره‌وری مخارج سرمایه‌ای بهبود یابد تا جریان نقد آزاد پایدارتر شود.","priority_actions":["تقویت تبدیل سود به جریان نقد عملیاتی","کاهش نوسان سرمایه در گردش","بهبود بهره‌وری مخارج سرمایه‌ای"],"avoid_or_guardrail":"افزایش تعهدات نقدی بلندمدت بدون تقویت جریان نقد آزاد با احتیاط انجام شود.","severity":2,"domain":"کیفیت سود و نقدسازی","source_codes":["R1","R7","R10"]},{"code":"M4-GM","matrix":4,"x_band":"good","y_band":"medium","x_band_fa":"مطلوب","y_band_fa":"متوسط","title":"سود باکیفیت با ظرفیت بهبود نقدسازی","status_sentence":"سود از کیفیت مناسبی برخوردار است و جریان نقد آزاد نیز قابل‌قبول است، اما ظرفیت افزایش تبدیل سود به نقد وجود دارد.","micro_policy_title":"تقویت نقدسازی","micro_policy":"کیفیت سود حفظ و سرمایه در گردش و بهره‌وری مخارج سرمایه‌ای برای افزایش جریان نقد آزاد بهینه شود.","priority_actions":["حفظ کیفیت سود و کنترل اقلام تعهدی","بهبود سرمایه در گردش","افزایش بازده مخارج سرمایه‌ای و جریان نقد آزاد"],"avoid_or_guardrail":"بهبود نقدسازی نباید از مسیر کاهش سرمایه‌گذاری‌های ضروری و ارزش‌آفرین انجام شود.","severity":1,"domain":"نقدسازی","source_codes":["R1","R7","R10"]},{"code":"M4-WG","matrix":4,"x_band":"weak","y_band":"good","x_band_fa":"ضعیف","y_band_fa":"مطلوب","title":"جریان نقد آزاد قوی با کیفیت سود ضعیف","status_sentence":"شرکت جریان نقد آزاد قوی تولید می‌کند، اما کیفیت سود گزارش‌شده ضعیف است و پایداری نتیجه مالی باید با دقت بیشتری بررسی شود.","micro_policy_title":"تأیید پایداری سود","micro_policy":"منشأ جریان نقد آزاد و کیفیت سود همزمان بررسی شود تا مشخص شود نقد قوی ناشی از عملیات پایدار است یا عوامل موقت و غیرتکرارشونده.","priority_actions":["تطبیق سود خالص با جریان نقد عملیاتی","بررسی اقلام تعهدی و غیرتکرارشونده","کنترل پایداری جریان نقد آزاد در چند دوره"],"avoid_or_guardrail":"جریان نقد قوی یک دوره به‌تنهایی مبنای توسعه یا توزیع نقد بلندمدت قرار نگیرد.","severity":3,"domain":"کیفیت سود","source_codes":["R1","R7","R10"]},{"code":"M4-MG","matrix":4,"x_band":"medium","y_band":"good","x_band_fa":"متوسط","y_band_fa":"مطلوب","title":"نقدسازی قوی با کیفیت سود قابل‌قبول","status_sentence":"شرکت جریان نقد آزاد قوی و کیفیت سود قابل‌قبولی دارد و از توان مالی مناسبی برای کاهش بدهی، سرمایه‌گذاری یا توزیع نقد برخوردار است.","micro_policy_title":"حفظ انضباط نقد","micro_policy":"کیفیت سود حفظ و جریان نقد آزاد به فرصت‌های دارای بازده مناسب، کاهش بدهی یا توزیع منضبط نقد تخصیص یابد.","priority_actions":["حفظ تبدیل مناسب سود به نقد","اولویت‌بندی استفاده از جریان نقد آزاد","پایش اقلام تعهدی برای حفظ کیفیت سود"],"avoid_or_guardrail":"جریان نقد آزاد به طرح‌های کم‌بازده یا تعهدات دائمی بدون بررسی بازده تخصیص نیابد.","severity":1,"domain":"تخصیص نقد","source_codes":["R1","R7","R10"]},{"code":"M4-GG","matrix":4,"x_band":"good","y_band":"good","x_band_fa":"مطلوب","y_band_fa":"مطلوب","title":"سود باکیفیت و نقدسازی قوی","status_sentence":"سود شرکت از کیفیت بالا برخوردار است و به جریان نقد آزاد قوی تبدیل می‌شود؛ عملکرد مالی پشتوانه نقدی مناسبی دارد.","micro_policy_title":"بهره‌برداری منضبط از نقد قوی","micro_policy":"جریان نقد آزاد می‌تواند بین سرمایه‌گذاری‌های ارزش‌آفرین، کاهش بدهی و توزیع نقد تخصیص یابد؛ کیفیت سود و انضباط نقد حفظ شود.","priority_actions":["اولویت دادن به سرمایه‌گذاری‌های با بازده بالاتر از هزینه سرمایه","حفظ کیفیت سود و نقدسازی","مدیریت متوازن کاهش بدهی و توزیع نقد"],"avoid_or_guardrail":"نقد مازاد به رشد یا سرمایه‌گذاری کم‌بازده تخصیص نیابد.","severity":0,"domain":"تخصیص نقد و سرمایه","source_codes":["R1","R7","R10"]}],"policy_families":{"F01":{"title":"تثبیت فوری مالی و نقدینگی","posture":"دفاعی","intro":"اولویت نخست باید تثبیت توان پرداخت، حفاظت از نقد و کاهش فشار مالی باشد."},"F02":{"title":"اصلاح ساختار مالی و کاهش فشار بدهی","posture":"دفاعی/اصلاحی","intro":"اولویت اصلی اصلاح ساختار بدهی، کاهش فشار هزینه مالی و تقویت توان پوشش تعهدات است."},"F03":{"title":"بازیابی نقدینگی و سرمایه در گردش","posture":"اصلاحی","intro":"اولویت اصلی آزادسازی نقد از عملیات و بازگرداندن نقدینگی به سطح مطمئن است."},"F04":{"title":"بازسازی کیفیت سود و نقدسازی","posture":"اصلاحی","intro":"اولویت اصلی باید افزایش اتکاپذیری سود و ایجاد پشتوانه نقدی پایدار برای عملکرد گزارش‌شده باشد."},"F05":{"title":"تقویت تبدیل سود به جریان نقد آزاد","posture":"اصلاحی","intro":"اولویت اصلی افزایش تبدیل سود عملیاتی به جریان نقد آزاد و کاهش جذب غیرضروری نقد است."},"F06":{"title":"اعتبارسنجی و بهبود کیفیت سود","posture":"اصلاحی","intro":"اولویت اصلی بررسی پایداری سود و کاهش اتکای نتیجه مالی به اقلام تعهدی یا غیرتکرارشونده است."},"F07":{"title":"بهبود بازده سرمایه پیش از توسعه","posture":"اصلاحی/سرمایه‌ای","intro":"اولویت اصلی افزایش بازده سرمایه و بستن فاصله ارزش‌آفرینی پیش از گسترش سرمایه‌بر است."},"F08":{"title":"آزادسازی سرمایه و افزایش بهره‌وری منابع","posture":"اصلاحی/بهره‌وری","intro":"اولویت اصلی استفاده بهتر از دارایی و آزادسازی سرمایه‌ای است که بازده کافی ایجاد نمی‌کند."},"F09":{"title":"بازسازی عملیاتی و سودآوری","posture":"اصلاحی/عملیاتی","intro":"اولویت اصلی اصلاح اقتصاد عملیات و بازگرداندن سودآوری به سطح قابل‌اتکا است."},"F10":{"title":"اصلاح کیفیت رشد و حاشیه سود","posture":"اصلاحی/رشد","intro":"اولویت اصلی تبدیل رشد حجمی به رشد سودآور و جلوگیری از توسعه کم‌حاشیه است."},"F11":{"title":"رشد انتخابی و کم‌سرمایه","posture":"توسعه‌ای مشروط","intro":"شرکت می‌تواند رشد را دنبال کند، اما اولویت با توسعه انتخابی، کم‌سرمایه و دارای حاشیه سود و نقدسازی مناسب است."},"F12":{"title":"بهینه‌سازی متوازن عملکرد","posture":"بهینه‌سازی","intro":"اولویت با بهبود همزمان سودآوری، بهره‌وری سرمایه، نقدینگی و کیفیت نقدسازی بدون ایجاد عدم‌تعادل جدید است."},"F13":{"title":"رشد منضبط و مقیاس‌پذیر","posture":"توسعه‌ای","intro":"شرکت ظرفیت رشد دارد و می‌تواند توسعه را به‌صورت منضبط و با کنترل همزمان بازده سرمایه و نقدینگی ادامه دهد."},"F14":{"title":"توسعه و تخصیص فعال سرمایه","posture":"توسعه‌ای فعال","intro":"شرکت در موقعیت مناسبی برای توسعه فعال و تخصیص سرمایه به فرصت‌های دارای بازده بالا قرار دارد."},"F15":{"title":"حفظ عملکرد، تولید نقد و بازتخصیص سرمایه","posture":"حفظ/بازتخصیص","intro":"عملکرد جاری باید حفظ شود و در نبود فرصت رشد باکیفیت، نقد و سرمایه به فرصت‌های پربازده‌تر بازتخصیص یابد."},"F16":{"title":"حفظ انعطاف مالی و سرمایه‌گذاری انتخابی","posture":"حفظ/توسعه انتخابی","intro":"شرکت از ظرفیت مناسبی برای سرمایه‌گذاری برخوردار است، اما توسعه باید انتخابی و متناسب با بازده و حاشیه اطمینان مالی باشد."}},"trend_modifiers":[{"code":"T1","trend":"بهبود معنی‌دار نسبت به دوره قبل","urgency_effect":"یک پله کاهش در فوریت در صورت نبود گیت بحرانی","append_text":"روند مثبت است؛ اقدامات اصلاحی فعلی ادامه یابد تا وضعیت به‌طور پایدار وارد محدوده بالاتر شود."},{"code":"T2","trend":"بدون تغییر معنی‌دار","urgency_effect":"بدون تغییر","append_text":"وضعیت پایدار مانده است؛ اگر شرکت در محدوده ضعیف یا میانه است، اقدامات فعلی باید از نظر اثربخشی بازبینی شوند."},{"code":"T3","trend":"تضعیف معنی‌دار نسبت به دوره قبل","urgency_effect":"یک پله افزایش در فوریت","append_text":"روند منفی است؛ سطح مداخله مدیریتی و سرعت اجرای سیاست پیشنهادی افزایش یابد."},{"code":"T4","trend":"داده روند ناکافی","urgency_effect":"بدون تغییر، با کاهش سطح اطمینان","append_text":"به دلیل نبود سابقه کافی، سیاست بر وضعیت جاری استوار است و باید با احتیاط بیشتری تفسیر شود."}],"traces":["گیت سلامت مالی: ضعف هم‌زمان نقدینگی و ساختار مالی","گیت سلامت مالی: ضعف ساختار مالی","گیت سلامت مالی: ضعف نقدینگی","گیت کیفیت عملکرد: ضعف هم‌زمان کیفیت سود و جریان نقد آزاد","گیت کیفیت عملکرد: ضعف جریان نقد آزاد","گیت کیفیت عملکرد: ضعف کیفیت سود","گیت ارزش‌آفرینی: ضعف بازده اقتصادی سرمایه","گیت بهره‌وری سرمایه: بهره‌وری پایین منابع","گیت عملیات: ضعف سودآوری عملیاتی","گیت عملیات: رشد بالا با سودآوری ضعیف","رشد محدود بدون وجود گیت بحرانی","عدم وجود ضعف بحرانی و غلبه وضعیت‌های میانه","انعطاف مالی و نقدسازی مناسب با ظرفیت سرمایه‌گذاری انتخابی","غلبه وضعیت‌های مطلوب با چند حوزه قابل بهبود","رشد محدود در کنار بنیان مالی، نقدی و سرمایه‌ای قوی","تمام ابعاد در محدوده مطلوب"],"guards":["تا زمانی که نقدینگی و ساختار مالی به محدوده قابل‌قبول نرسیده‌اند، توسعه سرمایه‌بر، افزایش بدهی و توزیع نقد باید به موارد ضروری و دارای توجیه روشن محدود شود.","تا تقویت ساختار مالی و پوشش هزینه مالی، افزایش بدهی و توسعه سرمایه‌بر باید محدود و مرحله‌ای باشد.","تا بازیابی نقدینگی، رشد باید عمدتاً از مسیر فعالیت‌های کم‌سرمایه و نقدزا دنبال شود و تعهدات نقدی جدید با احتیاط پذیرفته شوند.","تا زمانی که کیفیت سود و جریان نقد آزاد به سطح پایدار نرسیده‌اند، تعهدات سرمایه‌ای و توزیع نقد باید محافظه‌کارانه باشد.","تا زمانی که بازده سرمایه به سطح ارزش‌آفرین نرسیده است، توسعه سرمایه‌بر فقط برای طرح‌هایی انجام شود که بازده مورد انتظار آنها به‌روشنی بالاتر از هزینه سرمایه است.","پیش از افزودن دارایی یا ظرفیت جدید، استفاده بهتر از منابع و سرمایه موجود در اولویت قرار گیرد.","رشد فقط در محصول، مشتری یا فعالیتی دنبال شود که حاشیه سود قابل‌قبول و مسیر روشن تبدیل به نقد داشته باشد.","اقدامات توسعه‌ای به‌صورت مرحله‌ای انجام شوند و اثر آنها بر سودآوری، بازده سرمایه، نقدینگی و کیفیت جریان نقد همزمان کنترل شود.","توسعه می‌تواند فعالانه ادامه یابد، مشروط به حفظ بازده سرمایه، حاشیه سود، کیفیت نقدسازی و حاشیه اطمینان مالی."],"actions":[["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","بررسی اختلاف سود خالص و جریان نقد عملیاتی","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","کاهش جذب نقد در مطالبات و موجودی","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","بهبود سرمایه در گردش و چرخه نقد","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","تحلیل نسبت جریان نقد عملیاتی به سود خالص (CFO/NI)","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","تقویت تبدیل سود به جریان نقد عملیاتی","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","حفظ کیفیت سود و کنترل اقلام تعهدی","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","تطبیق سود خالص با جریان نقد عملیاتی","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","حفظ تبدیل مناسب سود به نقد","شناسایی و آزادسازی دارایی‌ها و سرمایه‌های کم‌بازده"],["اجرای برنامه فوری مدیریت نقد و سرمایه در گردش","اولویت دادن به سرمای