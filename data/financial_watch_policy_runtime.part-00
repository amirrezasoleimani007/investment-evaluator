:6,"domain":"نقدینگی و ساختار مالی","source_codes":["R1","R5","R6"]},{"code":"M3-MW","matrix":3,"x_band":"medium","y_band":"weak","x_band_fa":"متوسط","y_band_fa":"ضعیف","title":"نقدینگی قابل‌مدیریت با ساختار مالی شکننده","status_sentence":"توان پرداخت کوتاه‌مدت فعلاً در سطح میانه است، اما اهرم مالی و پوشش هزینه مالی همچنان شکننده و نیازمند اصلاح‌اند.","micro_policy_title":"اصلاح ساختار بدهی","micro_policy":"کاهش فشار بدهی، بهبود پوشش هزینه مالی و اصلاح سررسیدها در اولویت باشد و رشد تا زمان تقویت ساختار مالی به‌صورت محتاطانه دنبال شود.","priority_actions":["کاهش بدهی و هزینه مالی در صورت امکان","افزایش پوشش هزینه مالی از طریق بهبود سود عملیاتی و ساختار بدهی","اصلاح ترکیب و سررسید منابع مالی"],"avoid_or_guardrail":"افزایش اهرم مالی یا تعهدات بلندمدت جدید بدون بهبود پوشش بدهی انجام نشود.","severity":5,"domain":"ساختار مالی","source_codes":["R1","R5","R6"]},{"code":"M3-GW","matrix":3,"x_band":"good","y_band":"weak","x_band_fa":"مطلوب","y_band_fa":"ضعیف","title":"نقدینگی مناسب با ساختار مالی پرریسک","status_sentence":"شرکت از نظر نقدینگی کوتاه‌مدت وضعیت مناسبی دارد، اما ساختار بدهی و اهرم مالی همچنان پرریسک است و نقد موجود نباید این ضعف را پنهان کند.","micro_policy_title":"ترمیم ساختار سرمایه","micro_policy":"از ظرفیت نقدینگی برای کاهش فشار بدهی، اصلاح سررسید و هزینه تأمین مالی استفاده شود و توسعه جدید با توجه به محدودیت اهرم مالی انتخاب شود.","priority_actions":["کاهش یا بازآرایی بدهی‌های پرهزینه","تقویت پوشش هزینه مالی","استفاده هدفمند از نقد مازاد برای کاهش ریسک ساختار مالی"],"avoid_or_guardrail":"وجود نقدینگی مناسب به‌تنهایی مجوز افزایش بدهی یا توسعه سرمایه‌بر تلقی نشود.","severity":4,"domain":"ساختار مالی","source_codes":["R1","R5","R6"]},{"code":"M3-WM","matrix":3,"x_band":"weak","y_band":"medium","x_band_fa":"ضعیف","y_band_fa":"متوسط","title":"فشار نقدینگی با ساختار مالی قابل‌کنترل","status_sentence":"ساختار مالی در سطح قابل‌کنترل است، اما ضعف نقدینگی کوتاه‌مدت می‌تواند عملیات و ایفای تعهدات جاری را تحت فشار قرار دهد.","micro_policy_title":"بازیابی نقدینگی","micro_policy":"تمرکز فوری بر آزادسازی نقد از مطالبات و موجودی، زمان‌بندی پرداخت‌ها و تأمین مالی کوتاه‌مدت متناسب باشد.","priority_actions":["کاهش دوره وصول مطالبات در حد امکان","بهینه‌سازی موجودی و چرخه تبدیل وجه نقد (CCC)","تنظیم جریان پرداخت و تأمین مالی کوتاه‌مدت"],"avoid_or_guardrail":"رشد فروش یا خرید موجودی که نیاز نقدینگی را بدون پشتوانه افزایش دهد دنبال نشود.","severity":5,"domain":"نقدینگی و سرمایه در گردش","source_codes":["R1","R5","R8","R9"]},{"code":"M3-MM","matrix":3,"x_band":"medium","y_band":"medium","x_band_fa":"متوسط","y_band_fa":"متوسط","title":"وضعیت مالی میانه و نیازمند حاشیه اطمینان","status_sentence":"نقدینگی و ساختار مالی هر دو در سطح میانه‌اند؛ شرکت با بحران فوری مواجه نیست، اما حاشیه اطمینان مالی محدود است.","micro_policy_title":"تقویت حاشیه اطمینان مالی","micro_policy":"نقدینگی، سررسید بدهی و پوشش هزینه مالی به‌صورت پیش‌نگر مدیریت شوند تا شرکت در برابر شوک‌های عملیاتی و مالی مقاوم‌تر شود.","priority_actions":["تقویت ذخیره نقد و خطوط تأمین مالی مطمئن","بهبود پوشش هزینه مالی و کنترل اهرم","کاهش نوسان سرمایه در گردش"],"avoid_or_guardrail":"توسعه‌ای که حاشیه اطمینان نقدینگی و پوشش بدهی را کاهش دهد با احتیاط انجام شود.","severity":2,"domain":"تاب‌آوری مالی","source_codes":["R1","R5","R6"]},{"code":"M3-GM","matrix":3,"x_band":"good","y_band":"medium","x_band_fa":"مطلوب","y_band_fa":"متوسط","title":"نقدینگی مناسب با ساختار مالی متوسط","status_sentence":"توان نقدینگی مطلوب است و ریسک ساختار مالی نیز قابل مدیریت است، اما هنوز ظرفیت بهینه‌سازی هزینه و ترکیب تأمین مالی وجود دارد.","micro_policy_title":"بهینه‌سازی تأمین مالی","micro_policy":"ترکیب بدهی، سررسیدها و هزینه منابع بهینه شود و سطح نقدینگی مناسب برای پشتیبانی از عملیات و رشد حفظ گردد.","priority_actions":["کاهش هزینه تأمین مالی در صورت امکان","بهبود ترکیب و سررسید بدهی","حفظ حاشیه نقدینگی مناسب در مسیر رشد"],"avoid_or_guardrail":"استفاده از نقدینگی مناسب برای پذیرش اهرم مالی نامتناسب انجام نشود.","severity":1,"domain":"تأمین مالی","source_codes":["R1","R5","R6"]},{"code":"M3-WG","matrix":3,"x_band":"weak","y_band":"good","x_band_fa":"ضعیف","y_band_fa":"مطلوب","title":"ساختار مالی سالم با ضعف نقدینگی","status_sentence":"ساختار بدهی و توان پوشش تعهدات بلندمدت مناسب است، اما ضعف نقدینگی نشان می‌دهد سرمایه در گردش یا زمان‌بندی جریان‌های نقد نیازمند اصلاح است.","micro_policy_title":"اصلاح سرمایه در گردش","micro_policy":"مدیریت مطالبات، موجودی، پرداخت‌ها و چرخه تبدیل وجه نقد (CCC) تقویت شود تا ساختار مالی سالم با نقدینگی عملیاتی مناسب همراه شود.","priority_actions":["کاهش دوره وصول مطالبات و کنترل اعتبار مشتریان","بهینه‌سازی موجودی متناسب با سطح خدمت","مدیریت زمان‌بندی پرداخت‌ها بدون آسیب به رابطه با تأمین‌کنندگان"],"avoid_or_guardrail":"برای جبران ضعف نقدینگی، بدهی جدید صرفاً به‌عنوان راه‌حل دائمی استفاده نشود.","severity":3,"domain":"سرمایه در گردش","source_codes":["R1","R5","R8","R9"]},{"code":"M3-MG","matrix":3,"x_band":"medium","y_band":"good","x_band_fa":"متوسط","y_band_fa":"مطلوب","title":"ساختار مالی قوی با نقدینگی قابل‌قبول","status_sentence":"ساختار مالی قوی است و نقدینگی نیز در سطح قابل‌قبولی قرار دارد؛ شرکت از انعطاف مالی مناسبی برخوردار است.","micro_policy_title":"حفظ انعطاف مالی","micro_policy":"حاشیه اطمینان نقدینگی و توان پوشش بدهی حفظ شود و از ظرفیت مالی برای فرصت‌های دارای بازده مناسب به‌صورت انتخابی استفاده گردد.","priority_actions":["حفظ سطح مناسب نقدینگی و پوشش بدهی","بهینه‌سازی هزینه تأمین مالی","استفاده انتخابی از ظرفیت بدهی برای طرح‌های ارزش‌آفرین"],"avoid_or_guardrail":"انعطاف مالی موجود نباید به افزایش غیرضروری بدهی یا تعهدات ثابت منجر شود.","severity":1,"domain":"انعطاف مالی","source_codes":["R1","R5","R6"]},{"code":"M3-GG","matrix":3,"x_band":"good","y_band":"good","x_band_fa":"مطلوب","y_band_fa":"مطلوب","title":"تاب‌آوری مالی قوی","status_sentence":"شرکت هم از نقدینگی مناسب و هم از ساختار مالی سالم برخوردار است و ظرفیت تحمل شوک و پشتیبانی از رشد بالاست.","micro_policy_title":"حفظ تاب‌آوری و استفاده منضبط از ظرفیت مالی","micro_policy":"ظرفیت مالی می‌تواند برای پشتیبانی از رشد و سرمایه‌گذاری‌های ارزش‌آفرین استفاده شود، مشروط به حفظ حاشیه