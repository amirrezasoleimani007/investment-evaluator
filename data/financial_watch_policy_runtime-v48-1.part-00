{"meta":{"name":"کتاب قاعده موتور سیاست‌گذاری دیده‌بان مالی","version":"1.2-final-managerial","language":"fa","matrices":4,"base_states":36,"combinations":6561,"policy_families":16,"score_boundaries":{"weak":"score < 3.33","medium":"3.33 <= score < 6.66","good":"score >= 6.66"},"policy_precedence":["توان پرداخت و فشار بدهی","کیفیت سود و جریان نقد","بازده و بهره‌وری سرمایه","رشد و سودآوری عملیات"],"implementation_note":"خروجی برای ورودی یکسان باید ثابت بماند. متن‌ها برای مخاطب مدیریتی و غیرمالی ساده‌سازی شده‌اند. تشخیص فقط بر وضعیت شاخص‌ها تکیه می‌کند و علت قطعی را بدون داده تکمیلی بیان نمی‌کند. پیشنهادها جهت اقدام و بررسی هستند و پیش از تصمیم سرمایه‌گذاری، تأمین مالی یا توزیع نقد باید با اطلاعات بودجه، پروژه‌ها و شرایط صنعت تطبیق داده شوند. امتیازهای نزدیک مرزهای طبقه‌بندی با برچسب «نزدیک مرز» نمایش داده می‌شوند و این برچسب طبقه‌بندی را تغییر نمی‌دهد."},"state_orders":[["M1-WW","M1-MW","M1-GW","M1-WM","M1-MM","M1-GM","M1-WG","M1-MG","M1-GG"],["M2-WW","M2-MW","M2-GW","M2-WM","M2-MM","M2-GM","M2-WG","M2-MG","M2-GG"],["M3-WW","M3-MW","M3-GW","M3-WM","M3-MM","M3-GM","M3-WG","M3-MG","M3-GG"],["M4-WW","M4-MW","M4-GW","M4-WM","M4-MM","M4-GM","M4-WG","M4-MG","M4-GG"]],"base_states":[{"code":"M1-WW","matrix":1,"x_band":"weak","y_band":"weak","x_band_fa":"ضعیف","y_band_fa":"ضعیف","title":"رشد و سودآوری هر دو ضعیف","status_sentence":"هم رشد فعالیت و هم سودآوری عملیاتی پایین است. این وضعیت نشان می‌دهد عملکرد جاری نیاز به اصلاح دارد؛ علت دقیق باید در فروش، قیمت، ترکیب محصول و هزینه‌ها بررسی شود.","micro_policy_title":"اصلاح پایه‌های عملیات","micro_policy":"ابتدا مشخص شود افت عملکرد از کدام محصول، مشتری، قیمت یا هزینه ناشی می‌شود؛ سپس برنامه اصلاح فروش و سودآوری اجرا شود و توسعه جدید تا روشن شدن اقتصاد عملیات محدود بماند.","priority_actions":["سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید","قیمت، تخفیف، بهای تمام‌شده و هزینه‌های عملیاتی را بازبینی کنید","برای بازیابی فروش، روی درآمدی تمرکز کنید که حاشیه سود قابل‌قبول دارد"],"avoid_or_guardrail":"افزایش حجم فروش یا ظرفیت، بدون روشن بودن حاشیه سود و بازده مورد انتظار، در اولویت قرار نگیرد.","severity":5,"domain":"عملیات و سودآوری","source_codes":["R1","R2","R3"]},{"code":"M1-MW","matrix":1,"x_band":"medium","y_band":"weak","x_band_fa":"متوسط","y_band_fa":"ضعیف","title":"رشد متوسط، سودآوری ضعیف","status_sentence":"فعالیت شرکت تا حدی رشد کرده، اما سودآوری عملیاتی هنوز پایین است. بنابراین افزایش فعالیت فعلاً به سود کافی تبدیل نشده است.","micro_policy_title":"تبدیل رشد به سود","micro_policy":"منابع رشد فروش بررسی شود تا مشخص شود کدام محصولات و مشتریان سود ایجاد می‌کنند و کدام بخش‌ها حاشیه را کاهش می‌دهند.","priority_actions":["حاشیه سود محصولات و مشتریان در حال رشد را مقایسه کنید","قیمت‌گذاری، تخفیف‌ها و ترکیب فروش را اصلاح کنید","رشد هزینه‌های عملیاتی را با رشد درآمد تطبیق دهید"],"avoid_or_guardrail":"رشد کم‌حاشیه صرفاً برای افزایش حجم یا سهم بازار ادامه پیدا نکند.","severity":4,"domain":"سودآوری و کیفیت رشد","source_codes":["R1","R2","R3"]},{"code":"M1-GW","matrix":1,"x_band":"good","y_band":"weak","x_band_fa":"مطلوب","y_band_fa":"ضعیف","title":"رشد خوب، سودآوری ضعیف","status_sentence":"رشد فعالیت مطلوب است، اما سودآوری عملیاتی پایین مانده است. یعنی رشد فعلی هنوز از نظر سود به کیفیت مطلوب نرسیده است.","micro_policy_title":"اصلاح کیفیت رشد","micro_policy":"رشد ادامه‌دار فقط در بخش‌هایی دنبال شود که حاشیه سود قابل‌قبول دارند و هم‌زمان قیمت، ترکیب فروش و هزینه‌های ناشی از رشد اصلاح شوند.","priority_actions":["رشد سودآور را از رشد کم‌حاشیه تفکیک کنید","قیمت و ترکیب محصول یا مشتری را بازبینی کنید","هزینه‌های ظرفیت، تخفیف و خدمت‌رسانی ناشی از رشد را کنترل کنید"],"avoid_or_guardrail":"تا زمانی که حاشیه سود بهبود نیافته، توسعه پرهزینه در بخش‌های کم‌حاشیه محدود شود.","severity":4,"domain":"کیفیت رشد و سودآوری","source_codes":["R1","R2","R3"]},{"code":"M1-WM","matrix":1,"x_band":"weak","y_band":"medium","x_band_fa":"ضعیف","y_band_fa":"متوسط","title":"رشد ضعیف، سودآوری متوسط","status_sentence":"سودآوری عملیاتی قابل‌قبول است، اما رشد فعالیت پایین است. مسئله اصلی در این وضعیت، پیدا کردن مسیر رشد بدون آسیب به حاشیه سود است.","micro_policy_title":"رشد انتخابی","micro_policy":"فرصت رشد در بازار، مشتری یا محصول بررسی شود و فقط گزینه‌هایی دنبال شوند که حاشیه سود فعلی را حفظ کنند.","priority_actions":["بازارها و مشتریان دارای حاشیه سود مناسب را شناسایی کنید","پیش از سرمایه‌گذاری جدید، امکان استفاده بیشتر از ظرفیت موجود را بررسی کنید","رشد فروش را همراه با کنترل حاشیه سود و دریافت نقد دنبال کنید"],"avoid_or_guardrail":"برای جبران رشد پایین، تخفیف سنگین یا توسعه‌ای که حاشیه سود را تضعیف کند دنبال نشود.","severity":2,"domain":"رشد","source_codes":["R1","R2","R3"]},{"code":"M1-MM","matrix":1,"x_band":"medium","y_band":"medium","x_band_fa":"متوسط","y_band_fa":"متوسط","title":"رشد و سودآوری در سطح متوسط","status_sentence":"رشد و سودآوری عملیاتی هر دو در محدوده متوسط قرار دارند. وضعیت بحرانی نیست، اما هنوز عملکرد برجسته‌ای در عملیات دیده نمی‌شود.","micro_policy_title":"بهبود هم‌زمان رشد و سود","micro_policy":"بهبود فروش، حاشیه سود و کنترل هزینه به‌صورت هم‌زمان دنبال شود و هر توسعه جدید مرحله‌ای و قابل‌اندازه‌گیری باشد.","priority_actions":["فروش و هزینه‌های عملیاتی را با هدف بهبود هم‌زمان رشد و حاشیه مدیریت کنید","تمرکز فروش را به محصولات و مشتریان با حاشیه بالاتر منتقل کنید","برای رشد و حاشیه سود، هدف‌های هم‌زمان و قابل سنجش تعیین کنید"],"avoid_or_guardrail":"بهبود یک‌جانبه حجم فروش یا کاهش هزینه نباید به تضعیف سود پایدار منجر شود.","severity":2,"domain":"بهینه‌سازی عملیات","source_codes":["R1","R2","R3"]},{"code":"M1-GM","matrix":1,"x_band":"good","y_band":"medium","x_band_fa":"مطلوب","y_band_fa":"متوسط","title":"رشد خوب، سودآوری متوسط","status_sentence":"رشد فعالیت مناسب است، اما سودآوری هنوز در سطح متوسط قرار دارد. ظرفیت اصلی بهبود، افزایش حاشیه سود در کنار حفظ رشد است.","micro_policy_title":"حفظ رشد و بهبود حاشیه","micro_policy":"رشد ادامه یابد، اما ادامه توسعه به حفظ یا بهبود حاشیه سود و کنترل هزینه‌های همراه رشد وابسته باشد.","priority_actions":["رشد را در بخش‌های دارای حاشیه مناسب حفظ کنید","حاشیه سود محصولات یا خدمات پرحجم را بهبود دهید","افزایش هزینه‌های عملیاتی هم‌زمان با رشد را کنترل کنید"],"avoid_or_guardrail":"رشد سریع بدون کنترل حاشیه سود و جریان نقد، به‌تنهایی نشانه موفقیت تلقی نشود.","severity":2,"domain":"رشد و سودآوری","source_codes":["R1","R2","R3"]},{"code":"M1-WG","matrix":1,"x_band":"weak","y_band":"good","x_band_fa":"ضعیف","y_band_fa":"مطلوب","title":"سودآوری خوب، رشد ضعیف","status_sentence":"عملیات سودآور است، اما رشد فعالیت پایین است. شرکت باید بین یافتن فرصت رشد باکیفیت و حفظ سود فعلی انتخاب آگاهانه داشته باشد.","micro_policy_title":"رشد از پایه سودآور","micro_policy":"فرصت‌های رشد انتخابی بررسی شوند؛ اگر فرصت مناسب وجود ندارد، حفظ حاشیه سود، تولید نقد و بازتخصیص منابع بر رشد اجباری مقدم باشد.","priority_actions":["فرصت‌های رشد با حاشیه‌ای هم‌سطح یا بهتر از وضع موجود را شناسایی کنید","پیش از توسعه سرمایه‌بر، امکان استفاده بیشتر از ظرفیت فعلی را بررسی کنید","بازارها، مشتریان یا محصولات مکمل را ارزیابی کنید"],"avoid_or_guardrail":"رشد اجباری که حاشیه سود فعلی را تضعیف کند دنبال نشود.","severity":1,"domain":"رشد انتخابی","source_codes":["R1","R2","R3"]},{"code":"M1-MG","matrix":1,"x_band":"medium","y_band":"good","x_band_fa":"متوسط","y_band_fa":"مطلوب","title":"سودآوری خوب، رشد متوسط","status_sentence":"سودآوری عملیاتی قوی است و رشد نیز در سطح قابل‌قبولی قرار دارد. این ترکیب امکان توسعه منضبط را فراهم می‌کند.","micro_policy_title":"رشد منضبط","micro_policy":"افزایش مقیاس روی فعالیت‌های سودآور دنبال شود و هم‌زمان اثر رشد بر بازده سرمایه و جریان نقد کنترل شود.","priority_actions":["فعالیت‌های با حاشیه و بازده بالاتر را گسترش دهید","انضباط قیمت‌گذاری و هزینه را در مسیر رشد حفظ کنید","ظرفیت و منابع را به بخش‌های با عملکرد بهتر اختصاص دهید"],"avoid_or_guardrail":"رشد نباید باعث افت محسوس حاشیه سود یا افزایش نامتناسب سرمایه درگیر شود.","severity":1,"domain":"رشد منضبط","source_codes":["R1","R2","R3"]},{"code":"M1-GG","matrix":1,"x_band":"good","y_band":"good","x_band_fa":"مطلوب","y_band_fa":"مطلوب","title":"رشد و سودآوری هر دو خوب","status_sentence":"رشد و سودآوری عملیاتی هم‌زمان مطلوب‌اند. این وضعیت از ادامه توسعه حمایت می‌کند، مشروط به اینکه بازده سرمایه و نقدینگی نیز حفظ شوند.","micro_policy_title":"توسعه کنترل‌شده عملیات","micro_policy":"رشد و افزایش مقیاس می‌تواند فعالانه‌تر دنبال شود، اما شاخص‌های بازده سرمایه، نقدینگی و حاشیه سود باید هم‌زمان پایش شوند.","priority_actions":["فعالیت‌ها و محصولات با حاشیه سود بالا را توسعه دهید","افزایش مقیاس را با کنترل بازده سرمایه انجام دهید","انضباط قیمت، هزینه و سرمایه در گردش را حفظ کنید"],"avoid_or_guardrail":"شتاب رشد نباید به افت بازده سرمایه یا تضعیف نقدینگی منجر شود.","severity":0,"domain":"توسعه عملیاتی","source_codes":["R1","R2","R3"]},{"code":"M2-WW","matrix":2,"x_band":"weak","y_band":"weak","x_band_fa":"ضعیف","y_band_fa":"ضعیف","title":"بهره‌وری و بازده سرمایه هر دو ضعیف","status_sentence":"هم استفاده از منابع ضعیف است و هم امتیاز بازده سرمایه پایین است. پیش از افزودن سرمایه جدید، باید مشخص شود چه بخشی از دارایی‌ها و سرمایه بازده کافی ایجاد نمی‌کند.","micro_policy_title":"اصلاح بازده و استفاده از سرمایه","micro_policy":"دارایی‌ها، سرمایه در گردش و طرح‌های سرمایه‌گذاری از نظر میزان استفاده و بازده بررسی شوند و توسعه سرمایه‌بر تا روشن شدن مسیر بهبود محدود بماند.","priority_actions":["دارایی‌ها و سرمایه‌های کم‌بازده یا کم‌استفاده را شناسایی کنید","مطالبات، موجودی و ظرفیت‌های بلااستفاده را در صورت وجود بررسی کنید","طرح‌های توسعه را بر مبنای بازده سرمایه بازبینی کنید"],"avoid_or_guardrail":"سرمایه‌گذاری توسعه‌ای جدید فقط زمانی دنبال شود که بازده مورد انتظار آن به‌روشنی قابل دفاع باشد.","severity":5,"domain":"بازده و بهره‌وری سرمایه","source_codes":["R2","R3","R4"]},{"code":"M2-MW","matrix":2,"x_band":"medium","y_band":"weak","x_band_fa":"متوسط","y_band_fa":"ضعیف","title":"بهره‌وری متوسط، بازده سرمایه ضعیف","status_sentence":"استفاده از منابع در سطح متوسط است، اما بازده سرمایه پایین است. مسئله اصلی این است که سرمایه موجود سود اقتصادی کافی ایجاد نمی‌کند.","micro_policy_title":"بهبود بازده پیش از توسعه","micro_policy":"حاشیه سود و میزان سرمایه درگیر هم‌زمان بررسی شوند تا مشخص شود بهبود بازده از مسیر سود بیشتر یا سرمایه کمتر امکان‌پذیر است.","priority_actions":["عوامل پایین بودن بازده سرمایه را مشخص کنید","سود عملیاتی را بدون افزایش نامتناسب سرمایه درگیر بهبود دهید","دارایی‌ها و سرمایه‌های کم‌بازده را برای آزادسازی منابع بررسی کنید"],"avoid_or_guardrail":"رشد سرمایه‌بر پیش از بهبود بازده سرمایه به اولویت اصلی تبدیل نشود.","severity":4,"domain":"بازده سرمایه","source_codes":["R2","R3","R4"]},{"code":"M2-GW","matrix":2,"x_band":"good","y_band":"weak","x_band_fa":"مطلوب","y_band_fa":"ضعیف","title":"بهره‌وری خوب، بازده سرمایه ضعیف","status_sentence":"دارایی‌ها نسبتاً خوب به کار گرفته می‌شوند، اما بازده سرمایه پایین است. بنابراین مسئله بیشتر در سود حاصل از سرمایه و هزینه تأمین آن باید بررسی شود.","micro_policy_title":"بهبود اقتصاد سرمایه","micro_policy":"تمرکز اصلی بر افزایش سود عملیاتی پس از مالیات و بهبود فاصله بازده سرمایه از هزینه سرمایه باشد؛ افزایش صرف حجم یا گردش دارایی کافی نیست.","priority_actions":["حاشیه سود عملیاتی و سود مبنای بازده سرمایه را بهبود دهید","قیمت، ترکیب محصول و هزینه‌های مرتبط با سرمایه را بازبینی کنید","فاصله بازده سرمایه از هزینه سرمایه را به‌صورت دوره‌ای کنترل کنید"],"avoid_or_guardrail":"افزایش حجم یا گردش دارایی بدون بهبود بازده اقتصادی به‌تنهایی موفقیت محسوب نشود.","severity":4,"domain":"بازده سرمایه و سودآوری","source_codes":["R2","R3","R4"]},{"code":"M2-WM","matrix":2,"x_band":"weak","y_band":"medium","x_band_fa":"ضعیف","y_band_fa":"متوسط","title":"بهره‌وری ضعیف، بازده سرمایه متوسط","status_sentence":"بازده سرمایه در سطح متوسط است، اما استفاده از منابع ضعیف است. لازم است مشخص شود آیا دارایی، سرمایه در گردش یا ظرفیت موجود بیش از نیاز درگیر شده است یا خیر.","micro_policy_title":"استفاده بهتر از منابع","micro_policy":"پیش از افزودن دارایی جدید، میزان استفاده از ظرفیت، مطالبات، موجودی و دارایی‌های کم‌استفاده بررسی و در صورت امکان منابع آزاد شود.","priority_actions":["میزان استفاده از دارایی‌ها و ظرفیت موجود را افزایش دهید","مطالبات و موجودی مازاد را در صورت وجود کاهش دهید","دارایی‌های کم‌استفاده یا غیرمولد را تعیین تکلیف کنید"],"avoid_or_guardrail":"پیش از توسعه دارایی جدید، امکان استفاده بهتر از منابع موجود بررسی شود.","severity":3,"domain":"بهره‌وری سرمایه","source_codes":["R2","R3","R4","R8"]},{"code":"M2-MM","matrix":2,"x_band":"medium","y_band":"medium","x_band_fa":"متوسط","y_band_fa":"متوسط","title":"بهره‌وری و بازده سرمایه در سطح متوسط","status_sentence":"بهره‌وری منابع و بازده سرمایه هر دو در محدوده متوسط‌اند. ظرفیت بهبود هم در سودآوری و هم در نحوه استفاده از سرمایه وجود دارد.","micro_policy_title":"بهبود متوازن سرمایه","micro_policy":"حاشیه سود، گردش دارایی و سرمایه درگیر هم‌زمان مدیریت شوند تا بازده سرمایه بدون فشار اضافی بر نقدینگی بهتر شود.","priority_actions":["حاشیه سود و سود عملیاتی را بهبود دهید","گردش دارایی و استفاده از ظرفیت موجود را افزایش دهید","سرمایه درگیر مازاد در فعالیت‌های کم‌بازده را کاهش دهید"],"avoid_or_guardrail":"بهبود یک شاخص نباید به قیمت تضعیف شاخص دیگر انجام شود.","severity":2,"domain":"بهینه‌سازی سرمایه","source_codes":["R2","R3","R4"]},{"code":"M2-GM","matrix":2,"x_band":"good","y_band":"medium","x_band_fa":"مطلوب","y_band_fa":"متوسط","title":"بهره‌وری خوب، بازده سرمایه متوسط","status_sentence":"منابع شرکت به‌خوبی استفاده می‌شوند، اما بازده سرمایه هنوز در سطح متوسط است. مهم‌ترین فرصت، افزایش سود حاصل از سرمایه موجود است.","micro_policy_title":"افزایش بازده با حفظ بهره‌وری","micro_policy":"کارایی موجود حفظ شود و تمرکز بر افزایش سود عملیاتی پس از مالیات و بهبود بازده سرمایه باشد.","priority_actions":["گردش مناسب دارایی را حفظ کنید","حاشیه سود و سود مبنای بازده سرمایه را افزایش دهید","طرح‌ها و فعالیت‌های با بازده بالاتر را در اولویت قرار دهید"],"avoid_or_guardrail":"سرمایه جدید صرفاً برای افزایش حجم، بدون بهبود بازده اقتصادی، تخصیص نیابد.","severity":2,"domain":"ارزش‌آفرینی سرمایه","source_codes":["R2","R3","R4"]},{"code":"M2-WG","matrix":2,"x_band":"weak","y_band":"good","x_band_fa":"ضعیف","y_band_fa":"مطلوب","title":"بازده سرمایه خوب، بهره‌وری منابع ضعیف","status_sentence":"بازده سرمایه مناسب است، اما بهره‌وری منابع پایین است. پیش از سرمایه‌گذاری جدید، باید امکان استفاده بهتر از دارایی‌ها و 