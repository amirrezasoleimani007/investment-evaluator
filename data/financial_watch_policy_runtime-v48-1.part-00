,"source_codes":["R1","R5","R8","R9"]},{"code":"M3-MG","matrix":3,"x_band":"medium","y_band":"good","x_band_fa":"متوسط","y_band_fa":"مطلوب","title":"ساختار بدهی خوب، نقدینگی متوسط","status_sentence":"ساختار مالی قوی است و نقدینگی نیز قابل‌قبول است. شرکت از انعطاف مالی مناسبی برخوردار است، هرچند حفظ حاشیه نقد همچنان اهمیت دارد.","micro_policy_title":"حفظ انعطاف مالی","micro_policy":"سطح مناسب نقدینگی و توان بازپرداخت بدهی حفظ شود و ظرفیت مالی فقط برای فرصت‌های با بازده روشن استفاده گردد.","priority_actions":["سطح مناسب نقدینگی و پوشش بدهی را حفظ کنید","هزینه تأمین مالی را بهینه کنید","ظرفیت بدهی را فقط برای طرح‌های ارزش‌آفرین و انتخابی به کار بگیرید"],"avoid_or_guardrail":"انعطاف مالی موجود نباید به افزایش غیرضروری بدهی یا تعهدات ثابت منجر شود.","severity":1,"domain":"انعطاف مالی","source_codes":["R1","R5","R6"]},{"code":"M3-GG","matrix":3,"x_band":"good","y_band":"good","x_band_fa":"مطلوب","y_band_fa":"مطلوب","title":"نقدینگی و ساختار بدهی هر دو خوب","status_sentence":"شرکت هم نقدینگی مناسب دارد و هم شاخص‌های بدهی و پوشش هزینه مالی مطلوب‌اند. این وضعیت از تاب‌آوری مالی و رشد پشتیبانی می‌کند.","micro_policy_title":"استفاده منضبط از ظرفیت مالی","micro_policy":"ظرفیت مالی می‌تواند برای رشد و سرمایه‌گذاری استفاده شود، مشروط به حفظ نقدینگی و توان بازپرداخت بدهی.","priority_actions":["سطح مناسب نقدینگی و پوشش هزینه مالی را حفظ کنید","از ظرفیت تأمین مالی برای طرح‌های پربازده به‌صورت منضبط استفاده کنید","بدهی‌ها و نیازهای نقدی آینده را به‌طور مستمر پایش کنید"],"avoid_or_guardrail":"رشد نباید حاشیه امن مالی را به‌طور محسوس کاهش دهد.","severity":0,"domain":"تاب‌آوری مالی","source_codes":["R1","R5","R6"]},{"code":"M4-WW","matrix":4,"x_band":"weak","y_band":"weak","x_band_fa":"ضعیف","y_band_fa":"ضعیف","title":"کیفیت سود و جریان نقد آزاد هر دو ضعیف","status_sentence":"سود گزارش‌شده پشتوانه نقدی ضعیفی دارد و جریان نقد آزاد نیز پایین است. قبل از اتکا به سود برای تصمیم‌گیری، علت فاصله سود و نقد باید روشن شود.","micro_policy_title":"بررسی کیفیت سود و نقد","micro_policy":"تفاوت سود با جریان نقد عملیاتی، تغییرات سرمایه در گردش، مخارج سرمایه‌ای و موارد غیرتکراری بررسی شوند تا مشخص شود سود گزارش‌شده تا چه حد به پول نقد واقعی تبدیل می‌شود.","priority_actions":["تفاوت سود خالص و جریان نقد عملیاتی را تحلیل کنید","بخش‌های سود که هنوز به نقد تبدیل نشده‌اند و درآمد یا هزینه‌های غیرتکراری را مشخص کنید","علت ضعف جریان نقد آزاد را بین سرمایه در گردش و مخارج سرمایه‌ای تفکیک کنید"],"avoid_or_guardrail":"تا زمانی که پایداری سود و جریان نقد روشن نشده، توزیع نقد و تعهدات سرمایه‌ای جدید محافظه‌کارانه باشد.","severity":5,"domain":"کیفیت سود و نقدسازی","source_codes":["R1","R7","R10"]},{"code":"M4-MW","matrix":4,"x_band":"medium","y_band":"weak","x_band_fa":"متوسط","y_band_fa":"ضعیف","title":"کیفیت سود متوسط، جریان نقد آزاد ضعیف","status_sentence":"کیفیت سود در سطح متوسط است، اما جریان نقد آزاد پایین است. باید مشخص شود نقد در سرمایه در گردش یا سرمایه‌گذاری‌های ثابت مصرف شده یا مسئله دیگری وجود دارد.","micro_policy_title":"بهبود تبدیل سود به نقد آزاد","micro_policy":"علت مصرف نقد پس از عملیات شناسایی شود و سرمایه در گردش و مخارج سرمایه‌ای از نظر ضرورت و بازده بررسی شوند.","priority_actions":["جذب نقد در مطالبات و موجودی را بررسی و در صورت امکان کاهش دهید","مخارج سرمایه‌ای را بر اساس ضرورت و بازده اولویت‌بندی کنید","تبدیل سود عملیاتی به جریان نقد آزاد را به‌صورت دوره‌ای پایش کنید"],"avoid_or_guardrail":"ضعف جریان نقد آزاد به‌تنهایی نباید باعث حذف سرمایه‌گذاری ضروری و ارزش‌آفرین شود؛ علت آن ابتدا مشخص شود.","severity":4,"domain":"نقدسازی","source_codes":["R1","R7","R10"]},{"code":"M4-GW","matrix":4,"x_band":"good","y_band":"weak","x_band_fa":"مطلوب","y_band_fa":"ضعیف","title":"کیفیت سود خوب، جریان نقد آزاد ضعیف","status_sentence":"سود پشتوانه نقد عملیاتی مناسبی دارد، اما جریان نقد آزاد پایین است. این وضعیت می‌تواند ناشی از سرمایه‌گذاری یا جذب نقد در سرمایه در گردش باشد و نیاز به تفکیک علت دارد.","micro_policy_title":"بررسی محل مصرف نقد","micro_policy":"کیفیت سود حفظ شود و مشخص شود جریان نقد آزاد پایین ناشی از سرمایه‌گذاری ارزش‌آفرین است یا مصرف نامطلوب نقد.","priority_actions":["سرمایه در گردش و تغییرات آن را بررسی کنید","مخارج سرمایه‌ای را از نظر بازده و زمان‌بندی ارزیابی کنید","جریان نقد آزاد را در کنار مرحله رشد و برنامه سرمایه‌گذاری تفسیر کنید"],"avoid_or_guardrail":"جریان نقد آزاد ضعیف بدون بررسی علت، به‌تنهایی مبنای توقف سرمایه‌گذاری یا افزایش بدهی قرار نگیرد.","severity":3,"domain":"نقدسازی و سرمایه در گردش","source_codes":["R1","R7","R8","R10"]},{"code":"M4-WM","matrix":4,"x_band":"weak","y_band":"medium","x_band_fa":"ضعیف","y_band_fa":"متوسط","title":"کیفیت سود ضعیف، جریان نقد آزاد متوسط","status_sentence":"جریان نقد آزاد تا حدی قابل‌قبول است، اما کیفیت سود پایین است. بنابراین پایداری سود گزارش‌شده باید جداگانه بررسی شود.","micro_policy_title":"اعتبارسنجی سود","micro_policy":"سود خالص با جریان نقد عملیاتی مقایسه شود و بخش‌هایی که هنوز به نقد تبدیل نشده‌اند یا یک‌باره‌اند جدا شوند تا سود قابل اتکاتری برای تصمیم‌گیری به دست آید.","priority_actions":["جریان نقد عملیاتی را با سود خالص مقایسه کنید","بخش‌های سود که هنوز به نقد تبدیل نشده‌اند و اقلام غیرتکراری را جدا کنید","برای تصمیم‌های سرمایه‌گذاری، سود تکرارپذیر پس از حذف اقلام غیرعادی را مبنا قرار دهید"],"avoid_or_guardrail":"تصمیم توسعه یا توزیع نقد صرفاً بر مبنای سود حسابداری انجام نشود.","severity":4,"domain":"کیفیت سود","source_codes":["R1","R7","R10"]},{"code":"M4-MM","matrix":4,"x_band":"medium","y_band":"medium","x_band_fa":"متوسط","y_band_fa":"متوسط","title":"کیفیت سود و جریان نقد آزاد در سطح متوسط","status_sentence":"کیفیت سود و جریان نقد آزاد هر دو قابل‌قبول اما متوسط‌اند. فرصت اصلی، تبدیل پایدارتر سود به نقد است.","micro_policy_title":"تقویت تبدیل سود به نقد","micro_policy":"کیفیت سود، سرمایه در گردش و بازده مخارج سرمایه‌ای هم‌زمان بهبود یابند تا جریان نقد آزاد پایدارتر شود.","priority_actions":["تبدیل سود به جریان نقد عملیاتی را تقویت کنید","نوسان سرمایه در گردش را کاهش دهید","بازده و ضرورت مخارج سرمایه‌ای را بهبود دهید"],"avoid_or_guardrail":"تعهدات نقدی بلندمدت جدید متناسب با توان پایدار تولید جریان نقد آزاد پذیرفته شوند.","severity":2,"domain":"کیفیت سود و نقدسازی","source_codes":["R1","R7","R10"]},{"code":"M4-GM","matrix":4,"x_band":"good","y_band":"medium","x_band_fa":"مطلوب","y_band_fa":"متوسط","title":"کیفیت سود خوب، جریان نقد آزاد متوسط","status_sentence":"کیفیت سود مناسب است و جریان نقد آزاد نیز قابل‌قبول است. ظرفیت بهبود بیشتر در مدیریت سرمایه در گردش و سرمایه‌گذاری‌ها وجود دارد.","micro_policy_title":"حفظ کیفیت سود و افزایش نقد آزاد","micro_policy":"کیفیت سود حفظ شود و سرمایه در گردش و مخارج سرمایه‌ای برای افزایش جریان نقد آزاد بهینه شوند.","priority_actions":["کیفیت سود و فاصله آن با جریان نقد عملیاتی را پایش کنید","سرمایه در گردش را بهینه کنید","بازده مخارج سرمایه‌ای و جریان نقد آزاد را افزایش دهید"],"avoid_or_guardrail":"بهبود جریان نقد نباید از مسیر کاهش سرمایه‌گذاری‌های ضروری و ارزش‌آفرین انجام شود.","severity":1,"domain":"نقدسازی","source_codes":["R1","R7","R10"]},{"code":"M4-WG","matrix":4,"x_band":"weak","y_band":"good","x_band_fa":"ضعیف","y_band_fa":"مطلوب","title":"جریان نقد آزاد خوب، کیفیت سود ضعیف","status_sentence":"جریان نقد آزاد قوی است، اما کیفیت سود پایین است. باید بررسی شود نقد قوی ناشی از عملیات پایدار است یا از عواملی مانند آزادسازی موقت سرمایه در گردش یا کاهش سرمایه‌گذاری ایجاد شده است.","micro_policy_title":"بررسی پایداری سود و نقد","micro_policy":"منشأ جریان نقد آزاد و کیفیت سود هم‌زمان بررسی شوند تا پایداری عملکرد مشخص شود.","priority_actions":["سود خالص را با جریان نقد عملیاتی تطبیق دهید","بخش‌های سود که هنوز به نقد تبدیل نشده‌اند و اقلام غیرتکراری را بررسی کنید","پایداری جریان نقد آزاد را در چند دوره و در کنار مخارج سرمایه‌ای کنترل کنید"],"avoid_or_guardrail":"جریان نقد قوی یک دوره به‌تنهایی مبنای تعهد بلندمدت، توسعه یا توزیع نقد قرار نگیرد.","severity":3,"domain":"کیفیت سود","source_codes":["R1","R7","R10"]},{"code":"M4-MG","matrix":4,"x_band":"medium","y_band":"good","x_band_fa":"متوسط","y_band_fa":"مطلوب","title":"جریان نقد آزاد خوب، کیفیت سود متوسط","status_sentence":"جریان نقد آزاد قوی است و کیفیت سود نیز قابل‌قبول است. شرکت از ظرفیت مناسبی برای کاهش بدهی، سرمایه‌گذاری یا توزیع نقد برخوردار است.","micro_policy_title":"تخصیص منضبط نقد","micro_policy":"جریان نقد آزاد بین سرمایه‌گذاری‌های پربازده، کاهش بدهی و توزیع نقد با توجه به اولویت‌های شرکت تخصیص یابد و کیفیت سود حفظ شود.","priority_actions":["تبدیل مناسب سود به نقد را حفظ کنید","برای استفاده از جریان نقد آزاد، اولویت روشن تعیین کنید","اقلام تعهدی را برای حفظ کیفیت سود پایش کنید"],"avoid_or_guardrail":"نقد آزاد به طرح‌های کم‌بازده یا تعهدات دائمی بدون بررسی بازده تخصیص نیابد.","severity":1,"domain":"تخصیص نقد","source_codes":["R1","R7","R10"]},{"code":"M4-GG","matrix":4,"x_band":"good","y_band":"good","x_band_fa":"مطلوب","y_band_fa":"مطلوب","title":"کیفیت سود و جریان نقد آزاد هر دو خوب","status_sentence":"سود شرکت پشتوانه نقدی مناسبی دارد و جریان نقد آزاد نیز قوی است. این وضعیت انعطاف خوبی برای سرمایه‌گذاری، کاهش بدهی یا توزیع نقد ایجاد می‌کند.","micro_policy_title":"استفاده هدفمند از نقد آزاد","micro_policy":"نقد آزاد به گزینه‌ای اختصاص یابد که بیشترین ارزش را ایجاد می‌کند: سرمایه‌گذاری پربازده، کاهش بدهی یا توزیع منضبط نقد.","priority_actions":["سرمایه‌گذاری‌های با بازده بالاتر از هزینه سرمایه را در اولویت قرار دهید","کیفیت سود و توان تولید نقد را حفظ کنید","بین کاهش بدهی، سرمایه‌گذاری و توزیع نقد تعادل ایجاد کنید"],"avoid_or_guardrail":"نقد مازاد به رشد یا سرمایه‌گذاری کم‌بازده تخصیص نیابد.","severity":0,"domain":"تخصیص نقد و سرمایه","source_codes":["R1","R7","R10"]}],"policy_families":{"F01":{"title":"حفاظت فوری از نقد و توان پرداخت","posture":"حفاظتی فوری","intro":"اولویت نخست، جلوگیری از فشار بیشتر بر نقد و توان پرداخت شرکت است."},"F02":{"title":"کاهش فشار بدهی و اصلاح تأمین مالی","posture":"کاهش ریسک","intro":"اولویت اصلی، کاهش فشار بدهی و تقویت توان پرداخت هزینه‌های مالی است."},"F03":{"title":"تقویت نقدینگی و سرمایه در گردش","posture":"اصلاح نقدینگی","intro":"اولویت اصلی، آزادسازی نقد از عملیات و بازگرداندن نقدینگی به سطح مطمئن است."},"F04":{"title":"بهبود کیفیت سود و جریان نقد","posture":"اصلاحی","intro":"اولویت اصلی، روشن کردن کیفیت سود و ایجاد پشتوانه نقدی پایدار برای عملکرد گزارش‌شده است."},"F05":{"title":"افزایش تبدیل سود به جریان نقد آزاد","posture":"اصلاحی","intro":"اولویت اصلی، مشخص کردن محل مصرف نقد و افزایش تبدیل سود به جریان نقد آزاد است."},"F06":{"title":"بررسی و تقویت پایداری سود","posture":"اصلاحی","intro":"اولویت اصلی، اطمینان از تکرارپذیر بودن سود و کاهش اتکا به بخش‌هایی از سود است که هنوز به نقد تبدیل نشده‌اند یا غیرعادی و غیرتکراری‌اند."},"F07":{"title":"افزایش بازده سرمایه پیش از توسعه","posture":"اصلاح سرمایه","intro":"اولویت اصلی، بهبود بازده سرمایه پیش از افزایش سرمایه‌گذاری و ظرفیت است."},"F08":{"title":"استفاده بهتر از دارایی‌ها و منابع","posture":"بهبود بهره‌وری","intro":"اولویت اصلی، استفاده بهتر از دارایی‌ها و آزادسازی منابع کم‌بازده پیش از افزودن سرمایه جدید است."},"F09":{"title":"اصلاح سودآوری عملیات","posture":"اصلاح عملیات","intro":"اولویت اصلی، شناسایی علت ضعف سود و بهبود سوددهی فعالیت‌های جاری است."},"F10":{"title":"تبدیل رشد به سود","posture":"اصلاح رشد","intro":"اولویت اصلی، حفظ رشدهای سودآور و متوقف کردن رشدهایی است که حاشیه سود کافی ندارند."},"F11":{"title":"رشد انتخابی با سرمایه‌گذاری محدود","posture":"رشد محتاطانه","intro":"شرکت می‌تواند رشد را دنبال کند، اما بهتر است ابتدا از مسیرهای کم‌سرمایه و دارای حاشیه سود مناسب استفاده شود."},"F12":{"title":"بهبود متوازن عملکرد","posture":"بهبود متوازن","intro":"اولویت، بهبود تدریجی چند بُعد عملکرد بدون ایجاد فشار جدید بر نقد، بدهی یا بازده سرمایه است."},"F13":{"title":"رشد منضبط و قابل‌کنترل","posture":"رشد منضبط","intro":"پایه عملکرد مناسب است و توسعه می‌تواند با کنترل هم‌زمان سودآوری، بازده سرمایه و نقدینگی ادامه یابد."},"F14":{"title":"توسعه فعال و سرمایه‌گذاری هدفمند","posture":"توسعه فعال","intro":"شرکت در موقعیت مناسبی برای توسعه است و می‌تواند سرمایه را به فرصت‌هایی با بازده بالاتر هدایت کند."},"F15":{"title":"حفظ سود و انتقال سرمایه به فرصت‌های بهتر","posture":"حفظ و بازتخصیص","intro":"در نبود فرصت رشد باکیفیت، حفظ سود و نقد و انتقال منابع به فرصت‌های بهتر بر رشد اجباری مقدم است."},"F16":{"title":"سرمایه‌گذاری انتخابی با حفظ توان مالی","posture":"توسعه انتخابی","intro":"ظرفیت سرمایه‌گذاری وجود دارد، اما توسعه باید انتخابی و متناسب با بازده و حاشیه امن مالی باشد."}},"trend_modifiers":[{"code":"T1","trend":"بهبود میانگین امتیازها نسبت به دوره قبل","urgency_effect":"در صورت نبود افت در نقدینگی یا ساختار بدهی، یک پله کاهش در فوریت","append_text":"میانگین امتیازها بهتر شده است. با این حال، قبل از کاهش فوریت باید نقدینگی، ساختار بدهی و هر محوری که افت کرده جداگانه بررسی شود."},{"code":"T2","trend":"تغییر معناداری در میانگین امتیازها دیده نمی‌شود","urgency_effect":"بدون تغییر","append_text":"تصویر کلی تقریباً ثابت مانده است. اگر شرکت هنوز در محدوده ضعیف یا متوسط است، اثربخشی اقدام‌های جاری باید بررسی شود."},{"code":"T3","trend":"کاهش میانگین امتیازها نسبت به دوره قبل","urgency_effect":"یک پله افزایش در فوریت","append_text":"تصویر کلی تضعیف شده است. محورهایی که بیشترین افت را داشته‌اند باید مشخص و سرعت اقدام اصلاحی متناسب با آنها افزایش یابد."},{"code":"T4","trend":"داده کافی برای مقایسه روند وجود ندارد","urgency_effect":"بدون تغییر، با اطمینان کمتر","append_text":"به دلیل نبود سابقه کافی، نتیجه فقط بر وضعیت فعلی تکیه دارد و باید با احتیاط بیشتری تفسیر شود."},{"code":"T5","trend":"تصویر کلی پایدار/روبه‌بهبود است، اما یک محور حیاتی افت کرده","urgency_effect":"فوریت کاهش نمی‌یابد؛ محور حیاتی باید جداگانه بررسی شود","append_text":"میانگین کل به‌تنهایی برای اعلام بهبود کافی نیست. توان نقدینگی یا سلامت ساختار مالی افت معنادار داشته و باید قبل از کاهش فوریت، علت این افت و اثر آن بر توان پرداخت بررسی شود."}],"traces":["فشار هم‌زمان بر نقدینگی و بدهی","فشار بالا در ساختار بدهی","ضعف نقدینگی کوتاه‌مدت","ضعف هم‌زمان کیفیت سود و جریان نقد آزاد","جریان نقد آزاد ضعیف","کیفیت سود نیازمند بررسی","بازده سرمایه پایین","استفاده ضعیف از منابع","سودآوری عملیاتی ضعیف","رشد خوب اما سودآوری ضعیف","رشد محدود بدون ریسک بحرانی","بدون ضعف بحرانی؛ تمرکز بر بهبود متوازن","توان مالی و نقدی مناسب با چند حوزه قابل بهبود","بیشتر ابعاد مطلوب و بدون ضعف جدی","رشد محدود با بنیان مالی و سرمایه‌ای قوی","تمام ابعاد در محدوده مطلوب"],"guards":["تا زمانی که نقدینگی و فشار بدهی به سطح قابل‌مدیریت نرسیده، توسعه سرمایه‌بر، افزایش بدهی و توزیع نقد فقط در موارد ضروری و با توجیه روشن انجام شود.","تا بهبود توان بازپرداخت بدهی، افزایش بدهی و توسعه سرمایه‌بر محدود و مرحله‌ای باشد.","تا بازیابی نقدینگی، رشد عمدتاً از مسیرهای کم‌سرمایه و نقدزا دنبال شود و تعهدات نقدی جدید با احتیاط پذیرفته شوند.","تا روشن شدن پایداری سود و جریان نقد، توزیع نقد و تعهدات سرمایه‌ای جدید محافظه‌کارانه باشد.","جریان نقد آزاد ضعیف بدون بررسی علت، به‌تنهایی مبنای توقف سرمایه‌گذاری ارزش‌آفرین قرار نگیرد؛ اما ایجاد تعهدات جدید نیز تا روشن شدن علت محتاطانه باشد.","تصمیم توسعه، تأمین مالی یا توزیع نقد صرفاً بر سود گزارش‌شده متکی نباشد تا کیفیت و تکرارپذیری آن تأیید شود.","تا بهبود بازده سرمایه، توسعه سرمایه‌بر فقط برای طرح‌هایی انجام شود که بازده مورد انتظار آنها به‌روشنی بالاتر از هزینه سرمایه است.","پیش از افزودن دارایی یا ظرفیت جدید، استفاده بهتر از منابع و سرمایه موجود در اولویت باشد.","تا بازگشت سودآوری به سطح قابل‌قبول، رشد پرهزینه یا افزایش ظرفیت بدون اقتصاد روشن محدود شود.","رشد فقط در محصول، مشتری یا فعالیتی ادامه یابد که حاشیه سود قابل‌قبول و مسیر روشن تبدیل به نقد دارد.","رشد جدید مرحله‌ای باشد و در صورت افت حاشیه سود، بازده سرمایه یا نقدینگی، سرعت توسعه کاهش یابد.","اقدام‌ها مرحله‌ای باشند و اثر آنها بر سودآوری، بازده سرمایه، نقدینگی و جریان نقد هم‌زمان سنجیده شود.","سرمایه‌گذاری جدید فقط تا جایی ادامه یابد که حاشیه امن مالی و بازده سرمایه حفظ شوند.","رشد نباید به افت محسوس حاشیه سود، بازده سرمایه یا حاشیه امن مالی منجر شود.","برای ایجاد رشد ظاهری، سرمایه به فعالیت‌های کم‌بازده یا کم‌حاشیه منتقل نشود.","توسعه فعال مشروط به حفظ بازده سرمایه، کیفیت جریان نقد و توان مالی شرکت است."],"actions":[["یک برنامه کوتاه‌مدت جریان نقد تهیه و پرداخت‌های ضروری را اولویت‌بندی کنید","بدهی، هزینه مالی و سررسیدها را برای کاهش فشار و بازتنظیم احتمالی بررسی کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["بدهی‌های پرهزینه و ساختار تأمین مالی را برای اصلاح بررسی کنید","برای افزایش پوشش هزینه مالی، هم‌زمان سود عملیاتی و هزینه تأمین مالی را هدف‌گذاری کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["منابع و مصارف نقد کوتاه‌مدت را به‌صورت منظم پایش و کسری‌های پیش‌رو را مشخص کنید","مطالبات، موجودی و زمان‌بندی پرداخت‌ها را برای آزادسازی نقد بررسی کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["تفاوت سود خالص و جریان نقد عملیاتی و بخش‌های سودی را که هنوز به نقد تبدیل نشده‌اند بررسی کنید","علت ضعف جریان نقد آزاد را بین سرمایه در گردش، مخارج سرمایه‌ای و موارد غیرتکراری تفکیک کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["مشخص کنید جریان نقد پس از عملیات دقیقاً در کجا مصرف می‌شود","سرمایه در گردش و مخارج سرمایه‌ای را بر اساس ضرورت و بازده اولویت‌بندی کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["سود خالص را با جریان نقد عملیاتی و اقلام تعهدی تطبیق دهید","اقلام غیرتکراری را جدا و سود پایدارتر را برای تصمیم‌گیری محاسبه کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["عوامل پایین بودن بازده سرمایه را به تفکیک سود و سرمایه درگیر مشخص کنید","طرح‌های توسعه را با بازده مورد انتظار و هزینه سرمایه دوباره ارزیابی کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["استفاده از ظرفیت و دارایی موجود را پیش از افزودن سرمایه جدید بررسی کنید","مطالبات، موجودی و دارایی‌های کم‌استفاده را برای آزادسازی منابع ارزیابی کنید","سودآوری محصول، مشتری و کانال فروش را جداگانه بررسی کنید"],["سودآوری محصولات، مشتریان و کانال‌های فروش را تفکیک کنید","قیمت، بهای تمام‌شده و هزینه‌های عملیاتی را برای بازیابی حاشیه سود اصلاح کنید","حاشیه سود و سود عملیاتی را بهبود دهید"],["سودآوری محصولات، مشتریان و کانال‌های فروش را تفکیک کنید","قیمت، بهای تمام‌شده و هزینه‌های عملیاتی را برای بازیابی حاشیه سود اصلاح کنید","گردش مناسب دارایی را حفظ کنید"],["سودآوری محصولات، مشتریان و کانال‌های فروش را تفکیک کنید","قیمت، بهای تمام‌شده و هزینه‌های عملیاتی را برای بازیابی حاشیه سود اصلاح کنید","ذخیره نقد و دسترسی به منابع مالی مطمئن را تقویت کنید"],["سودآوری محصولات، مشتریان و کانال‌های فروش را تفکیک کنید","قیمت، بهای تمام‌شده و هزینه‌های عملیاتی را برای بازیابی حاشیه س